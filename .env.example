# Optional separate backend-private root for credentials, recommended with corporate SMB plan storage.
# BTV_AUTH_STORAGE_ROOT=C:\path\to\backend\private-data

MB_GENAI_API_KEY=replace-with-your-key
MB_GENAI_API_VERSION=replace-with-your-api-version
MB_GENAI_ENDPOINT=https://your-resource.openai.azure.com/
