# ---- Local pilot auth (register/login/admin approval) ----
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Set to true only once the app is served over HTTPS.
COOKIE_SECURE=
# Optional absolute/idle limits in milliseconds:
# SESSION_IDLE_MS=28800000
# SESSION_ABSOLUTE_MS=86400000

# bcrypt cost; allowed range 12-15, default 12. Benchmark before increasing.
# BCRYPT_COST=12
# Admin creation and resets use a hidden terminal prompt, never environment passwords.
